# Copy to .env ON THE SERVER ONLY, never push .env.
SITE_DOMAIN=preview.example.com
PREVIEW_USERNAME=replace-with-your-username
PREVIEW_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_PASSWORD_MIN_20_CHARACTERS

# Owner-only, non-financial Priority Monitor task editor (optional).
# KEEP EMPTY to disable writes safely. Use a unique high-entropy 32+ char key.
# GitHub token MUST be fine-grained, single repository, Issues: Read and Write ONLY.
# The GitHub issue body is public. Never enter invoice/customer/bank details.
SBI_TASK_OWNER_KEY=
SBI_GITHUB_ISSUES_TOKEN=
SBI_PRIORITY_DB_PATH=/var/lib/sbi-priority/tasks.sqlite3
