# Stage 6B: PACKAGE ONLY. Full Cloud Run gateway source; not a runnable AWS release.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
WORKDIR /app
RUN groupadd --system --gid 65534 sbi_stage6 || true
COPY dashboard_source/requirements.txt /tmp/dashboard-requirements.txt
RUN python3 -m pip install --disable-pip-version-check -r /tmp/dashboard-requirements.txt
COPY dashboard_source/ /app/
COPY staging/aws_lightsail/stage6b_build_guard.py /app/stage6b_build_guard.py
RUN python3 -m compileall -q /app && python3 /app/stage6b_build_guard.py --validate-source
USER 65534:65534
EXPOSE 8080
LABEL org.opencontainers.image.title="SBI full-dashboard package (non-deployable Stage6B)"
LABEL sbi.release.status="BLOCKED_PRIVATE_STAGING_AUTH_AND_BACKEND"
# No server starts: explicit hard stop. Do not replace with gunicorn until
# private auth origin, CSRF, identity, financial access and rollback gates pass.
CMD ["python3", "/app/stage6b_build_guard.py", "--block-startup"]
