# Stage 6R.2: package recovered original backend modules; inert private shell only.
# Existing previously approved local Stage 6D dashboard image is required.
# No pip install, no external image pull, no new paid infrastructure.
FROM sbi-stage6d-candidate:c949777ffa32
USER root
WORKDIR /opt/sbi-recovery
COPY --chown=65534:65534 backend_source/ /opt/sbi-backend-source/
COPY --chown=65534:65534 staging/aws_lightsail/stage6r2_backend_shell.py /opt/sbi-recovery/stage6r2_backend_shell.py
RUN python3 -m compileall -q /opt/sbi-backend-source /opt/sbi-recovery/stage6r2_backend_shell.py
USER 65534:65534
EXPOSE 8081
LABEL sbi.release.status="PRIVATE_RECOVERY_BACKEND_PACKAGE_ONLY_NO_FINANCE"
ENTRYPOINT ["python3","/opt/sbi-recovery/stage6r2_backend_shell.py"]
