# Rendered by the official nginx envsubst entrypoint. Only BACKEND_NAME
# is substituted; the companion ingress never receives report credentials.
server {
    listen 8080;
    server_name _;
    access_log off;
    client_max_body_size 1k;

    location / {
        proxy_pass http://${BACKEND_NAME}:8080;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_connect_timeout 3s;
        proxy_read_timeout 8s;
        proxy_send_timeout 8s;
    }
}
