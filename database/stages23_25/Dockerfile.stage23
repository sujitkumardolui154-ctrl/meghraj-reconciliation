ARG STAGE17_IMAGE
FROM ${STAGE17_IMAGE}
USER root
WORKDIR /app
COPY stage23_auth_bridge.py patch_stage23_candidate.py test_stage23_auth_bridge.py inspect_actual_auth_contract.py /app/
RUN chmod 0644 /app/stage23_auth_bridge.py /app/patch_stage23_candidate.py /app/test_stage23_auth_bridge.py /app/inspect_actual_auth_contract.py \
  && python3 -B patch_stage23_candidate.py \
  && python3 -B -m py_compile stage23_auth_bridge.py test_stage23_auth_bridge.py inspect_actual_auth_contract.py \
  && echo 'STAGE23_AUTH_CANDIDATE_BUILD=PASS'
# Derived candidate only. The Docker image does not configure credentials or
# publish a port. Database and Financial Engine remain unchanged.
